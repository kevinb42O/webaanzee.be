{
  "name": "webaanzee",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-seo-pages.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-seo-pages.mjs",
    "build": "vite build && node scripts/prune-dist-media.mjs && npm run build:ssr && node scripts/inject-prerender.mjs && node scripts/check-seo.mjs && npm run check:regions",
    "build:ssr": "vite build --ssr scripts/entry-server.tsx --outDir dist-ssr",
    "preview": "vite preview",
    "check:seo": "node scripts/check-seo.mjs",
    "check:home-motion": "node --experimental-strip-types scripts/check-home-motion.mjs",
    "check:regions": "node scripts/check-location-pages.mjs && node scripts/check-location-motion.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "puppeteer": "^25.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
